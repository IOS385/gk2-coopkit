<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GK2.CoopKit</AssemblyName>
    <RootNamespace>GK2.CoopKit</RootNamespace>
    <Version>1.2.0</Version>
    <Product>GK2.CoopKit</Product>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- Paths. Override in build/Local.props (copy from Local.props.example)
       or pass -p:GameDir="..." on the command line. -->
  <Import Project="build/Local.props" Condition="Exists('build/Local.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Graveyard Keeper 2</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/BepInEx</BepInExDir>
    <ManagedDir>$(GameDir)/GraveyardKeeper2_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx;0Harmony">
      <HintPath>$(BepInExDir)/core/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine;UnityEngine.CoreModule;UnityEngine.InputLegacyModule;UnityEngine.UI;UnityEngine.UIModule;Assembly-CSharp;LazyBearTechnology;Unity.TextMeshPro;Unity.Netcode.Runtime;UniTask">
      <HintPath>$(ManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')"
           Text="Game DLLs not found at $(ManagedDir). Set GameDir in build/Local.props or pass -p:GameDir=... ." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')"
           Text="BepInEx 5 core DLLs not found at $(BepInExDir)/core. Install BepInEx 5 (x64) into the game folder first, or set BepInExDir." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)/plugins" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(BepInExDir)/plugins" />
  </Target>

</Project>
